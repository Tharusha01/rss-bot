# ─────────────────────────────────────────────────────────────────────────────
# RSS News Bot — Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control!
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Target Telegram channel/group where articles are posted
# Use @channelusername or the numeric ID (e.g. -1001234567890)
CHANNEL_ID=@your_channel_here

# Comma-separated list of admin Telegram user IDs
# Only these users can run /addfeed, /removefeed, etc.
ADMIN_IDS=123456789,987654321

# ── Scheduler ─────────────────────────────────────────────────────────────────
# How often (in minutes) to poll feeds
FETCH_INTERVAL_MINUTES=5

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=data/rss_bot.db

# ── Article Extraction ────────────────────────────────────────────────────────
# Maximum characters for the article body sent to Telegram (max message is 4096)
MAX_SUMMARY_LENGTH=3500
# HTTP request timeout (seconds)
REQUEST_TIMEOUT=15
# Network retry attempts
MAX_RETRIES=3
# Delay between retries (seconds)
RETRY_DELAY_SECONDS=5

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Seconds to wait between Telegram messages (avoid flood control)
MESSAGE_DELAY_SECONDS=1.5
# Max new articles to post per feed per poll cycle
MAX_MESSAGES_PER_FEED=5

# ── Cleanup ───────────────────────────────────────────────────────────────────
# Delete sent-article records older than this many days
DB_CLEANUP_DAYS=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/rss_bot.log
